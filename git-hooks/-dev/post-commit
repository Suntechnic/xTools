#!/usr/bin/env bash
# .git/hooks/post-commit: уведомление о новом коммите через tg-send

set -u

notify_script="/usr/local/sbin/tg-send"

[[ -x "$notify_script" ]] || exit 0

repo=$(basename "$(git rev-parse --show-toplevel)")
branch=$(git rev-parse --abbrev-ref HEAD)
hash=$(git rev-parse --short HEAD)
author=$(git log -1 --pretty=%an)
subject=$(git log -1 --pretty=%s)

message=$(printf '📝 Новый коммит\nРепозиторий: %s\nВетка: %s\nКоммит: %s\nАвтор: %s\n%s' \
  "$repo" "$branch" "$hash" "$author" "$subject")

chat_id=$(git config --local telegram.chatid 2>/dev/null)
if [[ -n "$chat_id" ]]; then
  /usr/bin/timeout 30s "$notify_script" send --chat-id "$chat_id" --msg "$message" || \
    echo "tg-send: не удалось отправить уведомление" >&2
else
  /usr/bin/timeout 30s "$notify_script" send --msg "$message" || \
    echo "tg-send: не удалось отправить уведомление" >&2
fi

exit 0